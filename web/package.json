{
  "name": "kition-board-ui",
  "version": "0.1.5",
  "private": true,
  "description": "The Board kit's own editor (Kit Harness Protocol (KHP) 6.1), embedded by hosts over the Kit UI protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "engine": "sh scripts/build-engine.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:flow": "node tests/flow.mjs chromium && node tests/flow.mjs webkit",
    "test:pages": "node tests/pages.mjs chromium && node tests/pages.mjs webkit"
  },
  "dependencies": {
    "@kition/kdm": "^0.5.1",
    "@kition/kit-dev-host": "^0.5.1",
    "@kition/kit-host": "^0.5.1",
    "@kition/kit-ui-protocol": "^0.5.1",
    "@kition/kit-editor": "^0.5.1",
    "@kition/tessera-icons": "^0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "playwright": "1.59.1"
  }
}
